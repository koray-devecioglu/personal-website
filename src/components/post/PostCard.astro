---
/**
 * PostCard — one entry in a feed list.
 *
 * Used on `/`, `/posts`, `/tags/[slug]`, and `/series/[slug]`. Renders
 * as a horizontal row with a hover treatment that lifts the title but
 * leaves the card boundary quiet — cards should feel like editorial
 * index entries, not buttons.
 *
 * The title carries a per-post `transition:name`, mirrored by
 * PostHeader's h1, so navigating from a list to the article morphs the
 * title into place on view-transition browsers (crossfade elsewhere).
 *
 * Accepts a pre-computed `readingMinutes` so the caller controls the
 * cost of reading-time computation (one read of `render()` per post).
 */
import PostMeta from "./PostMeta.astro";
import { postPath, typeLabelFor, type ReadablePost } from "../../lib/posts";

interface Props {
  post: ReadablePost;
  readingMinutes?: number;
}

const { post, readingMinutes } = Astro.props;
const { title, description, date, tags } = post.data;
const href = postPath(post);
const typeLabel = typeLabelFor(post);
---

<article class="post-card">
  <a class="post-card__link" href={href}>
    <p class="post-card__type">{typeLabel}</p>
    <h2
      class="post-card__title"
      transition:name={`post-title-${post.collection}-${post.id}`}
    >
      {title}<span class="post-card__arrow" aria-hidden="true">→</span>
    </h2>
    <p class="post-card__dek">{description}</p>
  </a>
  <PostMeta date={date} readingMinutes={readingMinutes} tags={tags} linkTags={true} />
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--rule);
  }
  .post-card:last-child {
    border-bottom: 0;
  }
  .post-card__link {
    color: inherit;
    text-decoration: none;
    display: block;
  }
  .post-card__type {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent-strong);
    margin: 0 0 var(--space-2);
  }
  .post-card__title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 650;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    font-variation-settings: "opsz" 24;
    margin: 0 0 var(--space-2);
    text-wrap: balance;
    transition: color var(--motion-micro) var(--ease-out);
  }
  .post-card__link:hover .post-card__title,
  .post-card__link:focus-visible .post-card__title {
    color: var(--accent-strong);
  }
  /* The arrow earns its motion: it appears where the click will take
     you, only once the pointer commits to the row. */
  .post-card__arrow {
    display: inline-block;
    margin-inline-start: 0.35ch;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity var(--motion-standard) var(--ease-out),
      transform var(--motion-standard) var(--ease-spring);
  }
  .post-card__link:hover .post-card__arrow,
  .post-card__link:focus-visible .post-card__arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .post-card__dek {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    color: var(--fg-muted);
    margin: 0;
    max-width: 62ch;
    line-height: var(--leading-normal);
  }
</style>
