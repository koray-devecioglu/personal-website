---
/**
 * ScrollReveal — the one island behind the [data-reveal] primitive.
 *
 * Included once by BaseLayout. Watches every [data-reveal] element and
 * adds .is-revealed when it enters the viewport; elements already on
 * screen at load reveal immediately (the observer fires synchronously
 * on observe), which doubles as the page-entrance choreography.
 *
 * [data-reveal-stagger] parents get their direct [data-reveal] children
 * an incremental --reveal-delay so lists cascade instead of popping in
 * as a block.
 *
 * The matching styles live in src/styles/motion.css and are gated on
 * html[data-js] + prefers-reduced-motion, so this script is purely
 * progressive enhancement — it never *needs* to run for content to be
 * visible.
 *
 * Re-arms on astro:page-load, which fires both on initial load and
 * after every ClientRouter (view-transition) swap.
 */
---

<script>
  const STAGGER_STEP_MS = 70;
  const STAGGER_MAX_MS = 420;

  function initReveals(): void {
    const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
    if (targets.length === 0) return;

    for (const group of document.querySelectorAll("[data-reveal-stagger]")) {
      let index = 0;
      for (const child of group.querySelectorAll<HTMLElement>(
        ":scope > [data-reveal]",
      )) {
        child.style.setProperty(
          "--reveal-delay",
          `${Math.min(index * STAGGER_STEP_MS, STAGGER_MAX_MS)}ms`,
        );
        index += 1;
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-revealed");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
    );

    for (const target of targets) {
      if (target.classList.contains("is-revealed")) continue;
      observer.observe(target);
    }
  }

  document.addEventListener("astro:page-load", initReveals);
</script>
